---
import { WA_URL } from "../data/config";

const services = [
  {
    name: "Basic",
    price: "$7 USD",
    priceArs: "$10.500 ARS",
    features: [
      "Cortes",
      "Música",
      "Subtítulos simples",
    ],
  },
  {
    name: "Dynamic",
    price: "$10 USD",
    priceArs: "$15.000 ARS",
    featured: true,
    features: [
      "Storytelling | B-roll básico",
      "Cortes dinámicos",
      "Zooms",
      "Subtítulos atractivos",
      "Sound design",
    ],
  },
  {
    name: "Pro",
    price: "$15 USD",
    priceArs: "$22.500 ARS",
    features: [
      "Todo lo de Dynamic +",
      "Storytelling | B-roll avanzado",
      "Motion graphics básicos",
      "Efectos visuales avanzados",
      "Edición al ritmo de la música",
    ],
  },
];
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="services__header">
      <p class="label">Servicios</p>
      <h2 class="services__title">Qué incluye.</h2>
    </div>

    <div class="services__list">
      {services.map((s) => (
        <article class:list={["services__card", { "services__card--featured": s.featured }]}>
          {/* Etiqueta superior superpuesta para el plan destacado */}
          {s.featured && (
            <div class="services__badge">
              ⭐ MÁS ELEGIDO
            </div>
          )}
          
          <div class="services__top">
            <h3 class="services__name">{s.name}</h3>
            <span class="services__subtitle">DESDE</span>
            <div class="services__price-wrap">
              <span class="services__price">{s.price}</span>
              <span class="services__price-ars">{s.priceArs}</span>
            </div>
          </div>

          <ul class="services__features" role="list">
            {s.features.map((f) => (
              <li class="services__feature">
                <span class="services__feature-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href={WA_URL}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["services__cta", { "services__cta--featured": s.featured }]}
          >
            Hablemos
          </a>
        </article>
      ))}
    </div>

    <p class="services__note">
      Precios por video. Los pagos se coordinan por WhatsApp.
    </p>
  </div>
</section>

<style>
/* NUEVO: Variables de color actualizadas */
.services {
  /* Paleta "Quiet Luxury": Crema Perlado / Champagne Suave */
  --theme-accent: #EAE6DB; 
  --theme-border-hover: #F4F1EA; /* Crema un poco más claro para el brillo del borde */
  --theme-glow: rgba(234, 230, 219, 0.2); /* Sombra crema sutil */
}

.services__header {
  margin-bottom: var(--space-12);
  text-align: center;
}

.services__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 0.95;
  margin-top: var(--space-3);
  color: var(--white);
}

.services__list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem; 
  align-items: stretch; /* <-- Cambia 'center' por 'stretch' aquí */
  max-width: 1100px;
  margin: 0 auto;
}

/* Diseño individual de la tarjeta base */
.services__card {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 2.5rem 2rem;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}

/* Hover de tarjetas normales */
.services__card:hover {
  transform: translateY(-8px);
  border-color: var(--theme-border-hover);
  box-shadow: 0 16px 40px var(--theme-glow);
}

/* Tarjeta Destacada */
.services__card--featured {
  border: 2px solid var(--theme-accent);
  background: var(--bg); 
  transform: scale(1.05); 
  padding-block: 3.5rem; 
  z-index: 2;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3); 
}

/* Hover de la tarjeta destacada */
.services__card--featured:hover {
  transform: scale(1.05) translateY(-8px);
  box-shadow: 0 20px 50px var(--theme-glow); 
}

/* Etiqueta superpuesta */
.services__badge {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--theme-accent);
  color: #0c0c0b; /* Texto oscuro sobre crema queda legible y premium */
  padding: 0.35rem 1.25rem;
  border-radius: 99px;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  white-space: nowrap;
}

.services__top {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  margin-bottom: 2rem;
  border-bottom: 1px solid var(--border);
  padding-bottom: 1.5rem;
}

.services__name {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--white);
  margin-bottom: 0.5rem;
}

.services__subtitle {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 0.05em;
}

.services__price-wrap {
  display: flex;
  flex-direction: column; 
  gap: 0.2rem;
}

.services__price {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 3vw, var(--text-4xl)); 
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--theme-accent); 
}

.services__price-ars {
  font-size: var(--text-sm);
  color: var(--text-2);
  font-weight: 500;
}

/* Features */
.services__features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  flex: 1; 
  margin-bottom: 2.5rem;
}

.services__feature {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.95rem;
  color: var(--text-2);
  line-height: 1.5;
}

.services__feature-icon {
  color: var(--theme-accent); 
  flex-shrink: 0;
  margin-top: 0.1rem; 
}

/* CTA (Botones) */
.services__cta {
  display: block;
  text-align: center;
  padding: 1rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  background: transparent;
  transition: all var(--dur-fast) var(--ease);
  margin-top: auto;
}

.services__cta:hover {
  background: var(--bg-2);
  border-color: var(--theme-border-hover);
  color: var(--theme-accent); 
}

.services__cta--featured {
  background: var(--theme-accent);
  color: #0c0c0b; /* Botón destacado con texto oscuro para hacer contraste con el crema */
  border-color: var(--theme-accent);
}

.services__cta--featured:hover {
  filter: brightness(1.05); /* Como es un color claro, lo iluminamos levemente */
  transform: translateY(-2px);
  color:rgb(231, 231, 231);
}

.services__note {
  margin-top: var(--space-10);
  font-size: var(--text-sm);
  color: var(--text-3);
  text-align: center;
}

/* ---- Responsive ---- */
@media (max-width: 900px) {
  .services__list {
    grid-template-columns: 1fr;
    gap: 3rem; 
  }

  .services__card--featured {
    transform: none; 
    padding-block: 2.5rem;
  }
  
  .services__card--featured:hover {
    transform: translateY(-8px);
  }
}
</style>