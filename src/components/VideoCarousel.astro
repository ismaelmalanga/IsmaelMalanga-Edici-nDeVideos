---
import { VIDEOS } from "../data/config";
import {
  cldVideo,
  cldImage,
  cldImageSrcset,
  VIDEO_PREVIEW,
  VIDEO_PREVIEW_MOBILE,
  VIDEO_FULL,
  POSTER_SIZES_CAROUSEL,
} from "../lib/media";

const activeVideos = VIDEOS.filter((v) => v.src).map((v) => ({
  ...v,
  preview: cldVideo(v.src, VIDEO_PREVIEW),
  previewMobile: cldVideo(v.src, VIDEO_PREVIEW_MOBILE),
  full: cldVideo(v.src, VIDEO_FULL),
  posterSrc: v.poster ? cldImage(v.poster, 360) : "",
  posterSrcset: v.poster ? cldImageSrcset(v.poster) : "",
}));
---

<section class="trabajos section" id="trabajos">
  <div class="container">
    <div class="trabajos__header">
      <p class="label">Trabajos</p>
      <h2 class="trabajos__title">Algunos ejemplos.</h2>
    </div>
  </div>

  <div
    class="carousel"
    role="region"
    aria-label="Carrusel de trabajos de edición"
    aria-roledescription="carrusel"
  >
    <button class="carousel__arrow carousel__arrow--prev" aria-label="Trabajo anterior" id="carousel-prev">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="carousel__track" id="carousel-track" aria-live="polite">
      {activeVideos.map((video, i) => (
        <div
          class="carousel__slide"
          data-index={i}
          data-src={video.preview}
          data-src-mobile={video.previewMobile}
          data-full={video.full}
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${activeVideos.length}: ${video.title}`}
        >
          <div class="carousel__card">
            {video.posterSrc && (
              <img
                class="carousel__poster"
                src={video.posterSrc}
                srcset={video.posterSrcset}
                sizes={POSTER_SIZES_CAROUSEL}
                width="260"
                height="462"
                alt=""
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={i === 0 ? "auto" : "low"}
              />
            )}
            <video
              class="carousel__video"
              muted
              loop
              playsinline
              preload="none"
              aria-label={video.title}
            ></video>
            <!-- Ícono expandir -->
            <button class="carousel__expand" aria-label={`Ver ${video.title} en grande`} data-src={video.full}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
                <line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
              </svg>
            </button>
            <div class="carousel__meta">
              <span class="carousel__meta-title">{video.title}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <button class="carousel__arrow carousel__arrow--next" aria-label="Siguiente trabajo" id="carousel-next">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="carousel__dots" role="tablist" aria-label="Trabajos">
    {activeVideos.map((_, i) => (
      <button
        class="carousel__dot"
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        aria-label={`Ir al trabajo ${i + 1}`}
        data-dot={i}
      ></button>
    ))}
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" aria-modal="true" role="dialog" aria-label="Video en pantalla completa" hidden>
  <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
  <div class="lightbox__inner">
    <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <video
      class="lightbox__video"
      id="lightbox-video"
      controls
      playsinline
      loop
    ></video>
  </div>
</div>

<style>
.trabajos__header { margin-bottom: var(--space-12); }

.trabajos__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 0.95;
  margin-top: var(--space-3);
  color: var(--white);
}

.carousel {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding-block: var(--space-8);
  perspective: 1200px;
}

.carousel__track {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: clamp(420px, 60vh, 580px);
  width: 100%;
}

.carousel__slide {
  position: absolute;
  transition:
    transform var(--dur-slow) var(--ease),
    opacity var(--dur-slow) var(--ease),
    filter var(--dur-slow) var(--ease);
  cursor: pointer;
}

.carousel__slide[data-state="active"] {
  transform: translateX(0) scale(1) rotateY(0deg);
  opacity: 1;
  filter: none;
  z-index: 10;
}

.carousel__slide[data-state="prev"] {
  transform: translateX(-52%) scale(0.78) rotateY(12deg);
  opacity: 0.55;
  filter: brightness(0.6);
  z-index: 5;
}

.carousel__slide[data-state="next"] {
  transform: translateX(52%) scale(0.78) rotateY(-12deg);
  opacity: 0.55;
  filter: brightness(0.6);
  z-index: 5;
}

.carousel__slide[data-state="hidden"] {
  transform: translateX(0) scale(0.6);
  opacity: 0;
  pointer-events: none;
  z-index: 0;
}

.carousel__card {
  position: relative;
  width: clamp(160px, 22vw, 260px);
  aspect-ratio: 9 / 16;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-3);
  border: 1px solid var(--border);
  box-shadow: 0 24px 60px rgba(0,0,0,0.5);
}

.carousel__poster {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
  transition: opacity var(--dur-base) var(--ease);
}

.carousel__card.is-playing .carousel__poster {
  opacity: 0;
}

.carousel__video {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: var(--bg-3);
}

/* Botón expandir */
.carousel__expand {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(12,12,11,0.7);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,0.12);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--dur-fast), background var(--dur-fast);
  z-index: 5;
}

.carousel__slide[data-state="active"] .carousel__expand {
  opacity: 1;
}

.carousel__expand:hover {
  background: rgba(12,12,11,0.9);
}

.carousel__meta {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-4) var(--space-3) var(--space-3);
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 100%);
}

.carousel__meta-title {
  font-family: var(--font-display);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--white);
  letter-spacing: -0.01em;
}

.carousel__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--bg-3);
  border: 1px solid var(--border);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}

.carousel__arrow:hover {
  background: var(--surface);
  border-color: var(--text-3);
  color: var(--white);
}

.carousel__arrow--prev { left: clamp(var(--space-4), 4vw, var(--space-12)); }
.carousel__arrow--next { right: clamp(var(--space-4), 4vw, var(--space-12)); }

.carousel__dots {
  display: flex;
  justify-content: center;
  gap: var(--space-2);
  margin-top: var(--space-8);
}

.carousel__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--border);
  transition: background var(--dur-fast), width var(--dur-base) var(--ease);
}

.carousel__dot[aria-selected="true"] {
  background: var(--accent);
  width: 20px;
  border-radius: 3px;
}

/* ---- Lightbox ---- */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox[hidden] { display: none; }

.lightbox__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  animation: fade-in var(--dur-base) var(--ease);
}

.lightbox__inner {
  position: relative;
  z-index: 1;
  width: min(380px, 88vw);
  aspect-ratio: 9 / 16;
  border-radius: var(--radius-lg);
  overflow: hidden;
  animation: lb-enter var(--dur-slow) var(--ease);
  box-shadow: 0 40px 100px rgba(0,0,0,0.7);
}

.lightbox__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.lightbox__close {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  z-index: 10;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(12,12,11,0.8);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,0.15);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--dur-fast);
}

.lightbox__close:hover { background: rgba(12,12,11,0.95); }

@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes lb-enter {
  from { opacity: 0; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1); }
}

@media (max-width: 600px) {
  .carousel__track { height: clamp(340px, 65vw, 440px); }
  .carousel__card  { width: clamp(140px, 48vw, 200px); }
  .carousel__slide[data-state="prev"] { transform: translateX(-55%) scale(0.72) rotateY(8deg); }
  .carousel__slide[data-state="next"] { transform: translateX(55%) scale(0.72) rotateY(-8deg); }
  .carousel__arrow { display: none; }
  .lightbox__inner { width: min(320px, 92vw); }
}
</style>

<script>
  (function () {
    const track     = document.getElementById("carousel-track");
    const prevBtn   = document.getElementById("carousel-prev");
    const nextBtn   = document.getElementById("carousel-next");
    const dots      = document.querySelectorAll<HTMLElement>(".carousel__dot");
    const slides    = document.querySelectorAll<HTMLElement>(".carousel__slide");
    const total     = slides.length;
    let current     = 0;
    let isAnimating = false;
    let inView      = false;

    // Mismos criterios que el Hero: no autoplay en mobile / datos limitados /
    // conexión lenta / reduced-motion, y servimos el video en menor resolución
    // cuando el viewport es chico.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isMobile = window.matchMedia("(max-width: 768px)").matches;
    const connection = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    }).connection;
    const saveData = Boolean(connection?.saveData);
    const slowNet = ["slow-2g", "2g", "3g"].includes(connection?.effectiveType ?? "");
    const autoplayAllowed = !reduceMotion && !saveData && !slowNet;

    function getVideo(index: number): HTMLVideoElement | null {
      return slides[index]?.querySelector("video") ?? null;
    }

    function getCard(index: number): HTMLElement | null {
      return slides[index]?.querySelector(".carousel__card") ?? null;
    }

    function srcFor(slide: HTMLElement): string {
      return (isMobile ? slide.dataset.srcMobile : slide.dataset.src) || slide.dataset.src || "";
    }

    function startPlayback(index: number) {
      const video = getVideo(index);
      const slide = slides[index];
      const card = getCard(index);
      if (!video || !slide) return;
      const nextSrc = srcFor(slide);
      if (video.getAttribute("src") !== nextSrc) {
        video.src = nextSrc;
      }
      video.play()
        .then(() => card?.classList.add("is-playing"))
        .catch(() => {});
    }

    function playActive() {
      if (!inView || !autoplayAllowed) return;
      startPlayback(current);
    }

    function pauseAll() {
      slides.forEach((_, i) => {
        const v = getVideo(i);
        const c = getCard(i);
        if (!v) return;
        v.pause();
        c?.classList.remove("is-playing");
        if (i !== current) {
          v.removeAttribute("src");
          v.load();
        }
      });
    }

    function render() {
      slides.forEach((slide, i) => {
        let state = "hidden";
        if (i === current)                             state = "active";
        else if (i === (current - 1 + total) % total) state = "prev";
        else if (i === (current + 1) % total)          state = "next";
        slide.dataset.state = state;
      });
      dots.forEach((dot, i) => {
        dot.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    }

    function goTo(index: number) {
      if (isAnimating || index === current) return;
      isAnimating = true;
      pauseAll();
      current = (index + total) % total;
      render();
      playActive();
      setTimeout(() => { isAnimating = false; }, 500);
    }

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    track?.addEventListener("click", (e) => {
      const slide = (e.target as Element).closest<HTMLElement>(".carousel__slide");
      if (!slide) return;
      const idx = parseInt(slide.dataset.index ?? "0");
      if (idx !== current) {
        goTo(idx);
      } else if (!autoplayAllowed) {
        // Reduced-motion / datos limitados: reproducir recién al tocar el slide activo
        startPlayback(idx);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft")  goTo(current - 1);
      if (e.key === "ArrowRight") goTo(current + 1);
      if (e.key === "Escape")     closeLightbox();
    });

    let startX = 0;
    track?.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track?.addEventListener("touchend", (e) => {
      const delta = startX - e.changedTouches[0].clientX;
      if (Math.abs(delta) > 50) goTo(delta > 0 ? current + 1 : current - 1);
    }, { passive: true });

    render();

    const carouselRoot = document.querySelector(".carousel");
    if (carouselRoot) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            inView = entry.isIntersecting;
            if (inView) {
              playActive();
            } else {
              getVideo(current)?.pause();
              getCard(current)?.classList.remove("is-playing");
            }
          });
        },
        { rootMargin: "120px" }
      );
      io.observe(carouselRoot);
    }

    const lightbox      = document.getElementById("lightbox") as HTMLElement;
    const lightboxVideo = document.getElementById("lightbox-video") as HTMLVideoElement;
    const closeBtn      = document.getElementById("lightbox-close");
    const backdrop      = document.getElementById("lightbox-backdrop");

    function openLightbox(src: string) {
      lightboxVideo.src = src;
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      lightboxVideo.play().catch(() => {});
    }

    function closeLightbox() {
      lightbox.hidden = true;
      lightboxVideo.pause();
      lightboxVideo.src = "";
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLElement>(".carousel__expand").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const src = btn.dataset.src ?? "";
        if (src) openLightbox(src);
      });
    });

    closeBtn?.addEventListener("click", closeLightbox);
    backdrop?.addEventListener("click", closeLightbox);
  })();
</script>