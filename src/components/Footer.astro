---
import { SITE, CONTACT, WA_URL } from "../data/config";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__name">{SITE.name}</span>
      <span class="footer__role">{SITE.title}</span>
    </div>

    <nav class="footer__links" aria-label="Links de contacto">
      <a
        href={CONTACT.TikTokUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="footer__link"
      >
        TikTok
      </a>
      <a
        href={WA_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="footer__link"
      >
        WhatsApp
      </a>
    </nav>
  </div>

  <div class="container footer__bottom">
    <span class="footer__copy">© {year} {SITE.name}</span>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--border);
  padding-top: var(--space-10);
  padding-bottom: var(--space-8);
}

.footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
  padding-bottom: var(--space-8);
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--space-6);
}

.footer__brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.footer__name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--white);
}

.footer__role {
  font-size: var(--text-sm);
  color: var(--text-3);
}

.footer__links {
  display: flex;
  gap: var(--space-6);
}

.footer__link {
  font-size: var(--text-sm);
  color: var(--text-2);
  transition: color var(--dur-fast);
}

.footer__link:hover {
  color: var(--text);
}

.footer__bottom {
  display: flex;
  justify-content: flex-start;
}

.footer__copy {
  font-size: var(--text-xs);
  color: var(--text-3);
}
</style>
