---
import { SITE, WA_URL } from "../data/config";

const navLinks = [
  { href: "#trabajos", label: "Trabajos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#faq",       label: "FAQ" },
  { href: "#contacto",  label: "Contacto" },
];
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <!-- Logo -->
    <a href="#" class="header__logo" id="logo-link" aria-label="Volver al inicio">
      {SITE.name}
    </a>

    <!-- Nav desktop -->
    <nav class="header__nav" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a href={link.href} class="header__nav-link">{link.label}</a>
      ))}
    </nav>

    <!-- CTA desktop -->
    <a
      href={WA_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="header__cta"
      aria-label="Contactar por WhatsApp"
    >
      Hablemos
    </a>

    <!-- Hamburger mobile -->
    <button
      class="header__burger"
      id="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>
  </div>

  <!-- Menú mobile -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-menu__nav" aria-label="Menú mobile">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-menu__link">{link.label}</a>
      ))}
      <a
        href={WA_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-menu__cta"
      >
        Hablemos
      </a>
    </nav>
  </div>
</header>

<style>
/* ---- Header base ---- */
.header {
  /* Paleta "Quiet Luxury": Crema Perlado / Champagne Suave */
  --theme-accent: #EAE6DB; 
  --theme-glow: rgba(234, 230, 219, 0.15); /* Brillo cálido sutil */

  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(12, 12, 11, 0.88);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
  transition: border-color var(--dur-base) var(--ease);
}

.header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60px;
  gap: var(--space-6);
}

/* ---- Logo ---- */
.header__logo {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text);
  flex-shrink: 0;
  transition: color var(--dur-fast) var(--ease), text-shadow var(--dur-fast) var(--ease);
}

.header__logo:hover { 
  color: var(--theme-accent);
  text-shadow: 0 0 12px var(--theme-glow);
}

/* ---- Nav desktop ---- */
.header__nav {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  flex: 1;
  justify-content: center;
}

.header__nav-link {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-2);
  position: relative;
  padding-block: 2px;
  transition: color var(--dur-fast) var(--ease);
}

.header__nav-link::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--theme-accent); 
  transition: width var(--dur-base) var(--ease);
}

.header__nav-link:hover {
  color: var(--theme-accent);
}
.header__nav-link:hover::after,
.header__nav-link.is-active::after {
  width: 100%;
}
.header__nav-link.is-active {
  color: var(--theme-accent);
}

/* ---- CTA desktop (Botón Hablemos) ---- */
.header__cta {
  display: inline-flex;
  align-items: center;
  padding: 0.45rem 1.25rem; 
  font-size: var(--text-sm);
  font-weight: 600; 
  color: #0c0c0b; 
  background: var(--theme-accent);
  border: 1px solid var(--theme-accent);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}

.header__cta:hover { 
  background: #F4F1EA;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px var(--theme-glow);
}

/* ---- Hamburger ---- */
.header__burger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 36px;
  height: 36px;
  padding: 6px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: transparent;
  cursor: pointer;
  flex-shrink: 0;
}

.header__burger-line {
  display: block;
  width: 100%;
  height: 1.5px;
  background: var(--text);
  border-radius: 2px;
  transition: transform var(--dur-base) var(--ease), opacity var(--dur-base) var(--ease);
  transform-origin: center;
}

/* Estado abierto */
.header__burger[aria-expanded="true"] .header__burger-line:nth-child(1) {
  transform: translateY(3.5px) rotate(45deg);
}
.header__burger[aria-expanded="true"] .header__burger-line:nth-child(2) {
  transform: translateY(-3.5px) rotate(-45deg);
}

/* ---- Menú mobile ---- */
.mobile-menu {
  display: none;
  overflow: hidden;
  max-height: 0;
  transition: max-height var(--dur-slow) var(--ease);
  border-top: 1px solid transparent;
}

.mobile-menu.is-open {
  max-height: 400px;
  border-top-color: var(--border);
}

.mobile-menu__nav {
  display: flex;
  flex-direction: column;
  padding: var(--space-4) var(--gutter) var(--space-6);
  gap: var(--space-1);
}

.mobile-menu__link {
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--text-2);
  padding-block: var(--space-3);
  border-bottom: 1px solid var(--border);
  transition: color var(--dur-fast);
}
.mobile-menu__link:last-of-type { border-bottom: none; }
.mobile-menu__link:hover { color: var(--theme-accent); }

/* CTA Menu Mobile */
.mobile-menu__cta {
  display: block;
  text-align: center;
  margin-top: var(--space-4);
  padding: 0.85rem 1.5rem;
  font-size: var(--text-sm);
  font-weight: 600;
  color: #0c0c0b;
  background: var(--theme-accent);
  border: 1px solid var(--theme-accent);
  border-radius: var(--radius-sm);
  transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}

.mobile-menu__cta:hover { 
  background: #F4F1EA;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px var(--theme-glow);
}

/* ---- Responsive ---- */
@media (max-width: 768px) {
  .header__nav  { display: none; }
  .header__cta  { display: none; }
  .header__burger { display: flex; }
  .mobile-menu  { display: block; }
}
</style>

<script>
  // Scroll suave al inicio al hacer clic en el logo
  const logoLink = document.getElementById("logo-link");
  logoLink?.addEventListener("click", (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // Toggle menú mobile
  const toggle = document.getElementById("menu-toggle");
  const menu   = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("is-open", !open);
    menu?.setAttribute("aria-hidden", String(open));
  });

  // Cerrar al hacer click en un link del menú mobile
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      menu.classList.remove("is-open");
      menu.setAttribute("aria-hidden", "true");
    });
  });

  // Resaltar sección activa en el nav
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".header__nav-link");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            link.classList.toggle(
              "is-active",
              link.getAttribute("href") === `#${entry.target.id}`
            );
          });
        }
      });
    },
    { rootMargin: "-40% 0px -55% 0px" }
  );

  sections.forEach((s) => observer.observe(s));
</script>